def second_largest_unique(arr):
    first_max = second_max = float('-inf')
    seen = set()

    for num in arr:
        # Skip duplicates
        if num in seen:
            continue
        seen.add(num)

        # Update first and second max
        if num > first_max:
            second_max = first_max
            first_max = num
        elif first_max > num > second_max:
            second_max = num

    return second_max if second_max != float('-inf') else -1



print(second_largest_unique([3, 5, 2, 5, 6, 6, 1]))   # Output: 5
print(second_largest_unique([7, 7, 7]))               # Output: -1
print(second_largest_unique([10, 9, 8, 8, 7]))        # Output: 9
print(second_largest_unique([1]))                     # Output:-1
